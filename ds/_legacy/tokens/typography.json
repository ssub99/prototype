      "textStyleName": "Subheadline/Bold",
      "fontStyle": "Bold",
      "fontWeight": 700,
      "fontSize": 15,
      "lineHeight": 20,
      "css": "--rz-type-status-time",
      "note": "Status bar clock on iOS chrome."
    }
  },
  "roles": {
    "headline": "headline.bold",
    "body": "body01.regular",
    "controlLabel": "body02.bold",
    "controlLabelQuiet": "body02.regular",
    "caption": "small01.regular",
    "captionLight": "small01.light",
    "buttonLarge": "body02.bold",
    "buttonSmall": "small01.regular",
    "toast": "body02.medium",
    "input": "body02.medium"
  }
