{
  "$description": "Rallyz typography — Pretendard text styles from Fluid catalogs/rallyz/base.json",
  "family": "Pretendard",
  "letterSpacing": 0,
  "styles": {
    "headline.bold": {
      "textStyleName": "Headline/Bold",
      "fontStyle": "Bold",
      "fontWeight": 700,
      "fontSize": 20,
      "lineHeight": 30,
      "css": "--rz-type-headline-bold"
    },
    "headline.medium": {
      "textStyleName": "Headline/Medium",
      "fontStyle": "Medium",
      "fontWeight": 500,
      "fontSize": 20,
      "lineHeight": 30,
      "css": "--rz-type-headline-medium"
    },
    "headline.regular": {
      "textStyleName": "Headline/Regular",
      "fontStyle": "Regular",
      "fontWeight": 400,
      "fontSize": 20,
      "lineHeight": 30,
      "css": "--rz-type-headline-regular"
    },
    "body01.bold": {
      "textStyleName": "Body01/Bold",
      "fontStyle": "Bold",
      "fontWeight": 700,
      "fontSize": 16,
      "lineHeight": 24,
      "css": "--rz-type-body01-bold"
    },
    "body01.medium": {
      "textStyleName": "Body01/Medium",
      "fontStyle": "Medium",
      "fontWeight": 500,
      "fontSize": 16,
      "lineHeight": 24,
      "css": "--rz-type-body01-medium"
    },
    "body01.regular": {
      "textStyleName": "Body01/Regular",
      "fontStyle": "Regular",
      "fontWeight": 400,
      "fontSize": 16,
      "lineHeight": 24,
      "css": "--rz-type-body01-regular"
