    },
    "body02.medium": {
      "textStyleName": "Body02/Medium",
      "fontStyle": "Medium",
      "fontWeight": 500,
      "fontSize": 14,
      "lineHeight": 21,
      "css": "--rz-type-body02-medium"
    },
    "body02.regular": {
      "textStyleName": "Body02/Regular",
      "fontStyle": "Regular",
      "fontWeight": 400,
      "fontSize": 14,
      "lineHeight": 21,
      "css": "--rz-type-body02-regular"
    },
    "small01.bold": {
      "textStyleName": "Small01/Bold",
      "fontStyle": "Bold",
      "fontWeight": 700,
