    "button01.bold": {
      "textStyleName": "Button01/Bold",
      "fontStyle": "Bold",
      "fontWeight": 700,
      "fontSize": 14,
      "lineHeight": 21,
      "css": "--rz-type-button01-bold"
    },
    "button01.medium": {
      "textStyleName": "Button01/Medium",
      "fontStyle": "Medium",
      "fontWeight": 500,
      "fontSize": 14,
      "lineHeight": 21,
      "css": "--rz-type-button01-medium"
    },
    "button01.regular": {
      "textStyleName": "Button01/Regular",
      "fontStyle": "Regular",
      "fontWeight": 400,
      "fontSize": 14,
      "lineHeight": 21,
      "css": "--rz-type-button01-regular"
    },
    "button02.bold": {
      "textStyleName": "Button02/Bold",
      "fontStyle": "Bold",
      "fontWeight": 700,
      "fontSize": 12,
      "lineHeight": 18,
      "css": "--rz-type-button02-bold"
    },
    "button02.medium": {
      "textStyleName": "Button02/Medium",
      "fontStyle": "Medium",
      "fontWeight": 500,
      "fontSize": 12,
      "lineHeight": 18,
      "css": "--rz-type-button02-medium"
    },
    "button02.regular": {
      "textStyleName": "Button02/Regular",
      "fontStyle": "Regular",
